# 静态资产缓存策略（Workers static assets 原生支持 _headers）
# 字体子集会用同名文件重建，max-age 控制在 1 小时内，避免改字后访客命中旧子集缺字；
# 图片/音频统一在 images/ 与 audio/，1 天窗口可接受。
# 主页 / 与 /index.html 由 Worker 动态返回，不走这里，保持默认 etag 协商缓存。

/inv-b/fonts/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800
/inv-g/fonts/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800
/inv-o/fonts/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800
/inv-w/fonts/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/audio/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# 海报页 HTML 禁止缓存：编辑频繁，确保访客与微信 webview 每次拿最新版
/poster/chinese/poster.html
  Cache-Control: public, max-age=0, must-revalidate
/poster/western/poster-western.html
  Cache-Control: public, max-age=0, must-revalidate
/poster/chinese/poster-bride.html
  Cache-Control: public, max-age=0, must-revalidate
/poster/western/poster-western-bride.html
  Cache-Control: public, max-age=0, must-revalidate

# html2canvas-pro 是不变的工具库（211KB），长缓存 + immutable
/poster/html2canvas-pro.min.js
  Cache-Control: public, max-age=31536000, immutable
